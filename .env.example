# yohan-mcp v2 — 환경변수 예시. 복사해서 .env 로 쓰고 실제 값 채움.
# .env 는 .gitignore 로 제외됨 (시크릿 평문 노출 금지).

# ── Notion (P2 실동작) ──────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RESOURCE_DB_ID=
NOTION_SUMMARY_DB_ID=
NOTION_TRIPLE_DB_ID=
NOTION_AIDICT_DB_ID=
NOTION_EXECLOG_DB_ID=

# ── memory (P2 실동작) ──────────────────────────────────────────
# 미설정 시 리포 루트/memory 사용
MEMORY_DIR=

# ── Qdrant (P2.5 실동작) ────────────────────────────────────────
# 미설정 시 임베디드(:memory:) 폴백 — 영속 안 됨. 영속은 docker compose up -d 후 아래 URL.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=yohan_resources

# ── 임베딩 (P2.5 → P3) ──────────────────────────────────────────
# auto(기본: ollama→local→hash) | ollama | local(sentence-transformers) | openai | hash(의존성0 폴백)
# EMBED_BACKEND 우선, 없으면 구명칭 EMBEDDING_BACKEND 도 인식.
EMBED_BACKEND=ollama
# ollama 실모델(P3 기본). bge-m3=다국어/한국어 강함 dim 1024. (ollama pull bge-m3)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
OPENAI_API_KEY=

# ── Headroom 압축 프록시 (선택) ─────────────────────────────────
# 설정 시 status 도구에 headroom 헬스 한 줄 추가됨
HEADROOM_URL=http://localhost:8787

# ── Studio (P3 실동작) ──────────────────────────────────────────
# 둘 다 설정되면 실발행, 미설정이면 드라이런(변환 결과만, '발행 보류' 플래그).
STUDIO_API_URL=
STUDIO_API_KEY=

# ── n8n (P5 별도 트랙 예정, 현재 미사용) ────────────────────────
# P4 의 Protocol Engine 은 n8n·외부 큐·외부 스케줄러 없이 동작한다(승인큐=로컬 JSONL).
# 무인 always-on(L3+)은 P5 별도 트랙에서 다루며 n8n 채택 여부도 그때 결정.
# 아래 값은 현재 어떤 코드 경로에서도 사용되지 않는다(주석 처리 유지).
# N8N_URL=http://localhost:5678
# N8N_WEBHOOK_URL=
