# yohan-mcp v2 — 환경변수 예시. 복사해서 .env 로 쓰고 실제 값 채움.
# .env 는 .gitignore 로 제외됨 (시크릿 평문 노출 금지).

# ── Notion (P2 실동작) ──────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RESOURCE_DB_ID=
NOTION_SUMMARY_DB_ID=
NOTION_TRIPLE_DB_ID=
NOTION_AIDICT_DB_ID=
NOTION_EXECLOG_DB_ID=

# ── memory (P2 실동작) ──────────────────────────────────────────
# 미설정 시 리포 루트/memory 사용
MEMORY_DIR=

# ── Qdrant (P2.5 실동작) ────────────────────────────────────────
# 미설정 시 임베디드(:memory:) 폴백 — 영속 안 됨. 영속은 docker compose up -d 후 아래 URL.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=yohan_resources

# ── 임베딩 (P2.5 → P3) ──────────────────────────────────────────
# auto(기본: ollama→local→hash) | ollama | local(sentence-transformers) | openai | hash(의존성0 폴백)
# EMBED_BACKEND 우선, 없으면 구명칭 EMBEDDING_BACKEND 도 인식.
EMBED_BACKEND=ollama
# ollama 실모델(P3 기본). bge-m3=다국어/한국어 강함 dim 1024. (ollama pull bge-m3)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
OPENAI_API_KEY=

# ── Headroom 압축 프록시 (선택) ─────────────────────────────────
# 설정 시 status 도구에 headroom 헬스 한 줄 추가됨
HEADROOM_URL=http://localhost:8787

# ── Studio (P6 — MDX 파일 발행) ─────────────────────────────────
# 발행 = yohan-studio 레포의 src/content/blog/{slug}.mdx 파일 쓰기(HTTP API 아님).
# STUDIO_REPO_PATH: yohan-studio 로컬 클론 절대경로(미설정이면 드라이런 폴백).
STUDIO_REPO_PATH=
# 발행 서브경로(글 로더 기준 기본값).
STUDIO_PUBLISH_SUBDIR=src/content/blog
# PR 베이스 브랜치.
STUDIO_BASE_BRANCH=master
# 발행 모드: dry_run(기본, 파일 안 씀) | file(파일 쓰기) | pr(브랜치+PR).
# file/pr 은 always_gate — 명시적 승인(approve) 통과 시에만 실제로 쓴다.
STUDIO_PUBLISH_MODE=dry_run
# (선택) 연결 점검용 — health_check 의 /health probe 에만 쓰임. 발행과 무관.
STUDIO_API_URL=
STUDIO_API_KEY=

# ── 정책/스케줄러 (P5) ──────────────────────────────────────────
# 정책 엔진·트리거는 파일 기반(triggers.json + memory/*.jsonl) — 별도 env 불필요.
# 정책 자동승인은 기본 OFF(opt-in): triggers.json 의 policy 나 호출자가 명시 채택할 때만 켜진다.

# ── 트리거 실발화 (P7) ──────────────────────────────────────────
# cron 계열(interval/daily)은 TriggerEngine.tick() 으로 발화(cron 풀파서 없음 — every_sec/at).
# webhook 계열은 HMAC-SHA256 서명 검증 후 발화. 아래 시크릿 필수(미설정이면 모든 웹훅 거부).
# 상태/이력/락 저널은 data/(gitignore). 무인 발화여도 publish 는 always_gate 유지.
WEBHOOK_SECRET=

# ── n8n (P5-B 배포 트랙에서 채택 여부 결정, 현재 미사용) ─────────
# Protocol Engine(P4)·정책/스케줄러(P5)는 n8n·외부 큐·외부 스케줄러 없이 동작한다.
# 아래 값은 현재 어떤 코드 경로에서도 사용되지 않는다(주석 처리 유지).
# N8N_URL=http://localhost:5678
# N8N_WEBHOOK_URL=
